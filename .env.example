# Required in production
ADMIN_TOKEN=
TOKEN_SECRET=
SERVICE_PRIVATE_KEY=
SERVICE_NSEC=
NEXT_PUBLIC_SITE_URL=https://zap-battle.example.com

# Nostr session/profile/receipt relays
NOSTR_SESSION_RELAYS=wss://yabu.me,wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol
NEXT_PUBLIC_NOSTR_SESSION_RELAYS=wss://yabu.me,wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol

# Receipt publication targets included in signed Zap requests.
# The built-in public relays are retained as fallbacks for redundancy.
ZAP_REQUEST_RELAYS=wss://yabu.me,wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol
NEXT_PUBLIC_ZAP_REQUEST_RELAYS=wss://yabu.me,wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol

# Optional production hardening
ALLOWED_ORIGINS=https://example.com

# Development only. Leave unset in production unless explicitly needed.
NEXT_PUBLIC_ENABLE_DEMO_ZAPS=
